# ============================================================
# Red Chairs Barber — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio (ya está en .gitignore).
# ============================================================

# ------------------------------------------------------------
# Google Calendar (agenda operativa de los barberos)
# Ver README → "Integración con Google Calendar"
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Cada barbero tiene su propio calendario, completamente independiente.
GOOGLE_CALENDAR_ID_CAMILO=
GOOGLE_CALENDAR_ID_ALEJANDRO=

# ------------------------------------------------------------
# RED CLUB — Supabase
# Ver README → "RED CLUB (Supabase)"
# ------------------------------------------------------------

# PÚBLICAS: las lee el navegador. Deben llevar el prefijo VITE_.
# La anon key es pública por diseño; lo que protege los datos es Row
# Level Security, no el secreto de esta llave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PRIVADAS: solo las funciones serverless de /api.
# SUPABASE_SERVICE_ROLE_KEY se salta Row Level Security: NO debe llevar
# prefijo VITE_ ni aparecer nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Reseñas de Google (carrusel en el Inicio)
# Ver README → "Reseñas de Google en el inicio"
# ------------------------------------------------------------

# PÚBLICAS: las lee el navegador, igual que las de Supabase arriba.
# La API key queda visible en el código — lo que la protege es
# restringirla por dominio en Google Cloud Console, no el secreto.
# Si faltan estas dos, la sección simplemente no se muestra (el sitio
# sigue funcionando igual, sin reseñas).
VITE_GOOGLE_PLACE_ID=
VITE_GOOGLE_PLACES_API_KEY=

# ------------------------------------------------------------
# Opcionales
# ------------------------------------------------------------
# GOOGLE_CALENDAR_SLOT_DURATION_MINUTES=60
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
