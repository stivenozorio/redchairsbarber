# Google Calendar integration (see README.md "Integración con Google Calendar")
# Copy this file to .env and fill in real values — never commit .env.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Each barber has their own, fully independent Google Calendar.
GOOGLE_CALENDAR_ID_CAMILO=
GOOGLE_CALENDAR_ID_ALEJANDRO=

# Optional overrides
# GOOGLE_CALENDAR_SLOT_DURATION_MINUTES=60
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
